{
  "name": "@rootrouter/mcp",
  "version": "1.0.1",
  "description": "RootRouter MCP — index_repo, select_context (pointers mode), select_for_spec. Secondary surface for IDE cold slices; complements @rootrouter/proxy.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "rootrouter-mcp": "dist/server.js"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE", "COMMERCIAL.md", "BETA.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/sync-legal.mjs && npm run build",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test:smoke": "npm run build && node test/smoke.mjs"
  },
  "keywords": ["mcp", "model-context-protocol", "rootrouter", "context-selection", "token-reduction", "ai-agents"],
  "author": "Gerry Alvarez <aszalvarez@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "rootrouter": "^1.0.1",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RootRouter/RootRouter.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/RootRouter/RootRouter#readme",
  "bugs": "https://github.com/RootRouter/RootRouter/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
